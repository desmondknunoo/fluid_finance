# Public Firebase web configuration for the Fluid Finance project `finance-fluidterra`
# (finance.fluidterra account). Firebase console > Project settings > Your apps > Web app.
# This is NOT the investor app's app-fluidterra project. No secrets belong here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=finance-fluidterra.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=finance-fluidterra
# Fluid Finance backend (fluid_finance_backend); the local Compose stack is http://localhost:8001/api/v1
VITE_API_BASE_URL=https://api.finance.fluidterra.com/api/v1
