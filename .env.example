# Public Firebase web configuration for the Fluid Finance project (finance.fluidterra account).
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# This is NOT the investor app's app-fluidterra project. No secrets belong here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<finance-project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<finance-project-id>
# Fluid backend; local Compose stack is http://localhost:8000/api/v1
VITE_API_BASE_URL=https://api.fluidterra.com/api/v1
